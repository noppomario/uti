{
  "items": [
    {
      "type": "command",
      "name": "Files",
      "command": "nautilus",
      "args": ["--new-window"],
      "historySource": {
        "type": "recently-used",
        "appName": "org.gnome.Nautilus"
      }
    },
    {
      "type": "command",
      "name": "Text Editor",
      "command": "gnome-text-editor",
      "historySource": {
        "type": "recently-used",
        "appName": "gnome-text-editor",
        "path": "~/.local/share/org.gnome.TextEditor/recently-used.xbel"
      }
    },
    {
      "type": "folder",
      "name": "Dev",
      "children": [
        {
          "type": "command",
          "name": "VSCode Insiders",
          "command": "code-insiders",
          "historySource": {
            "type": "vscode",
            "path": "~/.config/Code - Insiders/User/globalStorage/state.vscdb"
          }
        },
        {
          "type": "command",
          "name": "Terminal",
          "command": "ptyxis",
          "args": ["--new-window"]
        }
      ]
    },
    { "type": "separator" },
    {
      "type": "command",
      "name": "Settings",
      "command": "gnome-control-center"
    }
  ]
}
