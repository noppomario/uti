  <project_license>MIT</project_license>
  <name>uti</name>
  <summary>Clipboard history, snippets and launcher on double Ctrl</summary>
  <description>
    <p>
      A popup for GNOME that opens at the pointer when Ctrl is pressed twice.
      It keeps clipboard history, stores snippets and launches apps or recent
      files, all from the keyboard.
    </p>
  </description>
  <launchable type="desktop-id">io.github.noppomario.uti.desktop</launchable>
  <developer id="io.github.noppomario">
    <name>noppomario</name>
  </developer>
  <url type="homepage">https://github.com/noppomario/uti</url>
  <url type="bugtracker">https://github.com/noppomario/uti/issues</url>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="0.4.2" date="2026-11-15"/>
    <release version="0.4.1" date="2026-11-15"/>
    <release version="0.4.0" date="2026-11-15"/>
    <release version="0.3.0" date="2026-11-15"/>
  </releases>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
  </supports>
