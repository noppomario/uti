{
  "name": "uti-monorepo",
  "version": "0.3.0",
  "private": true,
  "description": "Monorepo task runner for uti project",
  "scripts": {
    "app:lint": "cargo fmt -p uti --check && cargo clippy -p uti --all-targets",
    "app:test": "cargo test -p uti",
    "app:run": "./app/run-dev.sh",
    "app:rpm": "./app/packaging/build-rpm.sh",
    "app:all": "npm-run-all app:lint app:test",
    "daemon:format": "cd daemon && cargo fmt",
    "daemon:lint": "cd daemon && cargo fmt --check && cargo clippy --all-targets",
    "daemon:build": "cd daemon && cargo build --release",
    "daemon:test": "cd daemon && cargo test",
    "daemon:rpm": "./daemon/build-rpm.sh",
    "daemon:all": "npm-run-all daemon:format daemon:lint daemon:build daemon:test",
    "gnome:format": "cd gnome-extension && bunx --bun @biomejs/biome format --write .",
    "gnome:lint": "cd gnome-extension && bunx --bun @biomejs/biome check .",
    "gnome:all": "npm-run-all gnome:format gnome:lint",
    "rust:format": "cargo fmt --all",
    "rust:lint": "cargo fmt --all --check && cargo clippy --workspace --all-targets",
    "rust:build": "cargo build --workspace --release",
    "rust:test": "cargo test --workspace",
    "rust:all": "npm-run-all rust:format rust:lint rust:build rust:test",
    "all:format": "npm-run-all --parallel rust:format gnome:format",
    "all:lint": "npm-run-all --parallel rust:lint gnome:lint markdown:lint",
    "all:build": "npm run rust:build",
    "all:test": "npm run rust:test",
    "all:all": "npm-run-all all:format all:lint all:build all:test",
    "ci:check": "npm run all:lint",
    "ci:test": "npm run all:test",
    "ci:build": "npm run all:build",
    "ci:local": "npm-run-all ci:check ci:test ci:build",
    "security:rust": "cargo audit",
    "markdown:lint": "markdownlint-cli2 \"**/*.md\"",
    "markdown:fix": "markdownlint-cli2 --fix \"**/*.md\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "git-cliff": "^2.14.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "markdownlint-cli2": "^0.24.0",
    "npm-run-all": "^4.1.5"
  },
  "lint-staged": {
    "{app,daemon,crates}/**/*.rs": "sh -c 'cargo fmt --all' --",
    "gnome-extension/**/*.js": "sh -c 'cd gnome-extension && bunx --bun @biomejs/biome check --write \"$@\"' --",
    "**/*.md": "markdownlint-cli2 --fix"
  }
}
